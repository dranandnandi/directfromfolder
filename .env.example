# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Google Cloud API (for conversation analysis and audio transcription)
VITE_GEMINI_API_KEY=your_google_cloud_api_key

# External WhatsApp provider API
# Must be an https origin for any built/deployed app (Netlify + Android block cleartext).
# Use http://localhost:3001 only when running the bridge locally against the dev server.
VITE_EXTERNAL_WA_API_URL=https://whatsapp-automation.limsapp.in
VITE_EXTERNAL_WA_API_KEY=your_external_whatsapp_api_key
# Must match EXTERNAL_WA_API_KEY on the bridge server (set in the DigitalOcean
# app env). The bridge's hardcoded fallback is NOT the live value - copy the real
# key from the DO dashboard, never from this file.

# Supabase Edge Function Environment Variables
# These need to be set in your Supabase project dashboard under Settings > Edge Functions
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key
GEMINI_API_KEY=your_google_cloud_api_key
